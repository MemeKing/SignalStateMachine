[sub_resource type="GDScript" id="GDScript_23wuu"]
resource_name = "WeaponPickup"
script/source = "extends Area2D

@export var weapon : Script
@export var sprite : ImageTexture
@export var weapon_name : String


func _ready() -> void:
	$Label.text = weapon_name
	$AnimatedSprite2D.frame = randi_range(0,54)


func _on_body_entered(body: Node2D) -> void:
	body.equip_weapon(weapon.new())
	queue_free()
"

