[sub_resource type="GDScript" id="GDScript_s8qxd"]
script/source = "extends CharacterBody2D

@onready var fsm = $FSM
@export var basic_movement : FSMState
@export var weapon_attack : FSMState
@onready var dash = $FSM/RLDashState

@onready var attack_shape = $Attack/CollisionShape2D


func equip_weapon(wep : Script):
	fsm.revert()
	weapon_attack.queue_free()
	weapon_attack = wep.new()
	fsm.deploy_state(weapon_attack)
	fsm.unlink(basic_movement.attacked)
	fsm.link(basic_movement.attacked,weapon_attack)
	

func _ready() -> void:
	fsm.link(basic_movement.dashed,dash)
	fsm.link(basic_movement.attacked,weapon_attack)
"

