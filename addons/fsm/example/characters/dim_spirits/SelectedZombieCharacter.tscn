[sub_resource type="GDScript" id="GDScript_s8qxd"]
script/source = "extends CharacterBody2D

@export var weapon_script : Script

@onready var fsm = $SignalStateMachine
@onready var basic = $SignalStateMachine/JDBasicState
@onready var dash = $SignalStateMachine/RLDashState

@onready var attack_shape = $Attack/CollisionShape2D

var weapon_attack
var speed = 120
var jump_speed = -400.0
var grav = 300


func equip_weapon(wep : Script):
	weapon_attack.free()
	weapon_attack = wep.new()
	fsm.add_child(weapon_attack)
	fsm.unlink(basic,\"attacked\")
	fsm.setup()
	fsm.link(basic,\"attacked\",weapon_attack)

func _ready() -> void:
	weapon_attack = weapon_script.new()
	fsm.add_child(weapon_attack)
	fsm.link(basic,\"dashed\",dash)
	fsm.link(basic,\"attacked\",weapon_attack)
"

